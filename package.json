{
  "name": "pagina-apuestas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^5.9.3"
  }
}
